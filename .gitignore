# Braille tables copied from macOS by scripts/copy-braille-tables.sh.
# Apple-shipped liblouis files; regenerate locally rather than committing.
/data/

# Claude Code worktrees (see CLAUDE.md worktree workflow).
/.claude/worktrees/

# The LoT vault. Untracked from here on. `.lot.toml` points `lot` at the main
# checkout's vault by absolute path, so worktrees share that one vault rather
# than each carrying a copy whose updates have to be merged back.
/.lot-vault/

# Node / Vite. No trailing slash: worktrees symlink node_modules at the main
# checkout's copy, and a symlink is not matched by a directory-only pattern.
node_modules
dist/

# src/data/skills.json is generated (npm run generate) but IS committed,
# so the app builds without the macOS-only data/ tables present.
